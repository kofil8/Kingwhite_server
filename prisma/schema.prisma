// datasource and generator setup
datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---------------------------------------------------------
//  ENUMS
// ---------------------------------------------------------

enum status {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

enum NotificationType {
  BIRTHDAY_WISH
  COMMENT
  FAVORITE
  FOLLOW
}

// ---------------------------------------------------------
//  MODELS
// ---------------------------------------------------------
model User {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  firstName    String?
  lastName     String?
  email        String    @unique
  password     String
  userName     String
  dateOfBirth  String?
  status       status    @default(ACTIVE)
  profileImage Json?
  isAgreed     Boolean   @default(false)
  otp          String?
  otpExpiry    DateTime?

  fcmToken  String?
  hexCode   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role      Role     @default(USER)

  accounts Account[]
  profiles Profile[]
  goals    Goal[]

  isOnline         Boolean            @default(false)
  Investment       Investment[]
  SavingsPlan      SavingsPlan[]
  notifications    Notifications[]    @relation("Notifications")
  UserSubscription UserSubscription[]

  @@map("users")
}

model Otp {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String
  otp       Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("otps")
}

model Account {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  userId        String   @db.ObjectId
  accountType   String
  accountNumber String
  balance       Float
  user          User     @relation(fields: [userId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("accounts")
}

model Profile {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  address   String?
  phone     String?
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("profiles")
}

model InvestmentPortfolio {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  riskLevel   String
  description String?
  investments Investment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("investmentPortfolios")
}

model Investment {
  id          String              @id @default(auto()) @map("_id") @db.ObjectId
  userId      String              @db.ObjectId
  portfolioId String              @db.ObjectId
  amount      Float
  date        DateTime            @default(now())
  user        User                @relation(fields: [userId], references: [id])
  portfolio   InvestmentPortfolio @relation(fields: [portfolioId], references: [id])
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@map("investments")
}

model SavingsPlan {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  name      String
  frequency String
  amount    Float
  startDate DateTime
  endDate   DateTime?
  user      User      @relation(fields: [userId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("savingsPlans")
}

model Goal {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  userId        String   @db.ObjectId
  name          String
  targetAmount  Float
  currentAmount Float
  targetDate    DateTime
  user          User     @relation(fields: [userId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("goals")
}

model SubscriptionPlan {
  id               String             @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  price            Float
  features         String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  UserSubscription UserSubscription[]

  @@map("subscriptionPlans")
}

model UserSubscription {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  userId    String           @db.ObjectId
  planId    String           @db.ObjectId
  startDate DateTime         @default(now())
  endDate   DateTime?
  user      User             @relation(fields: [userId], references: [id])
  plan      SubscriptionPlan @relation(fields: [planId], references: [id])
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@map("userSubscriptions")
}

model Notifications {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  receiverId String   @db.ObjectId
  title      String
  body       String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [receiverId], references: [id], name: "Notifications")

  @@map("notifications")
}
